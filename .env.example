# 프론트엔드(Expo) 환경 변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# react-native-dotenv 로 로드되어 코드에서 `import { ... } from '@env'` 로 사용됩니다.
# .env 변경 후에는 캐시 클리어 재시작 필요:  npx expo start -c

# 백엔드 주소
#  - 미설정 시 localhost:3000 또는 운영 서버로 폴백
#  - 실기기(Expo Go)에서 로컬 서버에 붙으려면 PC의 LAN IP 사용
#    예) API_BASE_URL=http://192.168.0.10:3000   (확인: ipconfig getifaddr en0)
API_BASE_URL=

# Supabase (로그인 / 사용자 데이터)
SUPABASE_URL=
SUPABASE_ANON_KEY=
